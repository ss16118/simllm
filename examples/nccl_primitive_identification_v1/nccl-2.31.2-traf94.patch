 extern __shared__ ncclShmemData ncclShmem;
+
+// The helpers below are the only instrumentation interface used by primitive
+// headers.  Every helper checks the magic and enable bit, so a null control
+// pointer has exactly the original source behavior apart from one predictable
+// branch.  Diagnostic atomics use system scope because the control allocation
+// is shared by kernels running on more than one GPU.
+__device__ __forceinline__ ncclTraf94Control* ncclTraf94() {
+  ncclTraf94Control* c = ncclShmem.comm.traf94;
+  return c != nullptr && c->magic == NCCL_TRAF94_MAGIC && c->enabled ? c : nullptr;
+}
+
+__device__ __forceinline__ bool ncclTraf94CopyReduce() {
+  ncclTraf94Control* c = ncclTraf94();
+  return c != nullptr && c->family == ncclTraf94Copy;
+}
+
+__device__ __forceinline__ void ncclTraf94Published() {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c != nullptr && ncclShmem.comm.rank == (int)c->producerRank) {
+    __threadfence_system();
+    atomicExch_system(&c->producerReleased, 1u);
+  }
+}
+
+__device__ __forceinline__ void ncclTraf94Add(uint64_t* value, uint64_t amount) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c != nullptr && c->diagnostic) atomicAdd_system((unsigned long long*)value, (unsigned long long)amount);
+}
+
+__device__ __forceinline__ uint64_t ncclTraf94Timestamp() {
+  // clock64 is SM-local and can produce meaningless subtraction when a
+  // multi-channel interval begins and ends on different SMs.  Hopper's
+  // globaltimer is device-wide and expressed in nanoseconds.
+  uint64_t value;
+  asm volatile("mov.u64 %0, %globaltimer;" : "=l"(value));
+  return value;
+}
+
+__device__ __forceinline__ void ncclTraf94Geometry(int protocol, int nthreads) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  if (rank < 0 || rank >= NCCL_TRAF94_MAX_RANKS) { c->unsupportedSite = 1; return; }
+  c->realizedProtocol[rank] = protocol + 1;
+  c->realizedBlockThreads[rank] = blockDim.x;
+  c->realizedWorkWarps[rank] = nthreads / WARP_SIZE;
+  atomicOr(&c->realizedChannelMask[rank], 1u << ncclShmem.channelId);
+  uint32_t smid;
+  asm volatile("mov.u32 %0, %smid;" : "=r"(smid));
+  if (smid < 64) atomicOr((unsigned long long*)&c->realizedSmMaskLo[rank], 1ULL << smid);
+  else if (smid < 128) atomicOr((unsigned long long*)&c->realizedSmMaskHi[rank], 1ULL << (smid - 64));
+  else if (smid < 192) atomicOr((unsigned long long*)&c->realizedSmMask2[rank], 1ULL << (smid - 128));
+  else c->unsupportedSite = 1;
+}
+
+__device__ __forceinline__ void ncclTraf94PlacementEvidence(int placement) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  if (rank < 0 || rank >= NCCL_TRAF94_MAX_RANKS || placement < 0 || placement > 31) {
+    c->unsupportedSite = 1;
+    return;
+  }
+  // Several wait-role threads can report the same connection.  A bitmask makes
+  // the update idempotent and also exposes an unexpected mixture of modes.
+  atomicOr(&c->realizedPlacementMask[rank], 1u << placement);
+}
+
+__device__ __forceinline__ void ncclTraf94PeerEvidence(int recvPeer, int sendPeer) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  int channel = ncclShmem.channelId;
+  if (rank < 0 || rank >= NCCL_TRAF94_MAX_RANKS || channel < 0 ||
+      channel >= NCCL_TRAF94_MAX_CHANNELS || recvPeer < -1 ||
+      recvPeer >= NCCL_TRAF94_MAX_RANKS || sendPeer < -1 ||
+      sendPeer >= NCCL_TRAF94_MAX_RANKS) {
+    c->unsupportedSite = 1;
+    return;
+  }
+  // The probe forces Ring (one peer in each direction) or one-way P2P.  The
+  // +1 encoding distinguishes a real rank zero from an absent direction.
+  c->realizedRecvPeer[rank][channel] = recvPeer + 1;
+  c->realizedSendPeer[rank][channel] = sendPeer + 1;
+}
+
+__device__ __forceinline__ void ncclTraf94UserBuffer(void const* input) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  if (rank < 0 || rank >= NCCL_TRAF94_MAX_RANKS) {
+    c->unsupportedSite = 1;
+    return;
+  }
+  // Segmented sharing cells instantiate several primitives in one group.  The
+  // minimum source-observed pointer is the allocation offset for that whole
+  // iteration, independent of the order in which segment blocks start.
+  atomicMin_system((unsigned long long*)&c->observedInputPtr[rank],
+                   (unsigned long long)reinterpret_cast<uintptr_t>(input));
+}
+
+__device__ __forceinline__ void ncclTraf94ReadyObservation(bool ready) {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  if (rank == (int)c->consumerRank) {
+    if (c->family == ncclTraf94AlreadyReady) {
+      // DirectRead performs constructor-time pointer exchange before the
+      // producer can publish, so gate at the first source readiness
+      // observation.  A value loaded before this gate is stale by construction
+      // and is excluded; the primitive immediately reloads it.
+      while (atomicAdd_system(&c->producerReleased, 0u) == 0u) {}
+      if (c->intervalBegin[rank] == 0)
+        atomicCAS_system((unsigned long long*)&c->intervalBegin[rank], 0ULL,
+                         (unsigned long long)ncclTraf94Timestamp());
+      if (!ready) return;
+    } else if (c->intervalBegin[rank] == 0) {
+      atomicCAS_system((unsigned long long*)&c->intervalBegin[rank], 0ULL,
+                       (unsigned long long)ncclTraf94Timestamp());
+    }
+    if (c->family == ncclTraf94DelayedPublication) {
+      atomicExch_system(&c->consumerStarted, 1u);
+      __threadfence_system();
+    }
+  }
+  if (c->diagnostic) {
+    atomicAdd_system((unsigned long long*)&c->readinessChecks, 1ULL);
+    atomicAdd_system((unsigned long long*)(ready ? &c->successfulObservations : &c->unsuccessfulChecks), 1ULL);
+  }
+}
+
+__device__ __forceinline__ void ncclTraf94BeforePublication() {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr || c->family != ncclTraf94DelayedPublication ||
+      ncclShmem.comm.rank != (int)c->producerRank) return;
+  int rank = ncclShmem.comm.rank;
+  if (atomicCAS_system(&c->publicationDelayApplied[rank], 0u, 1u) == 0u) {
+    while (atomicAdd_system(&c->consumerStarted, 0u) == 0u) {}
+    uint64_t begin = clock64();
+    while (clock64() - begin < c->delayCycles) {}
+    uint64_t elapsed = clock64() - begin;
+    c->observedDelay[rank] = elapsed;
+    __threadfence_system();
+    atomicExch_system(&c->producerReleased, 1u);
+    atomicExch_system(&c->publicationDelayApplied[rank], 2u);
+  } else {
+    // Publication stores from other workers must not pass the worker applying
+    // the intervention.  State 2 is a device-visible release for the group.
+    while (atomicAdd_system(&c->publicationDelayApplied[rank], 0u) != 2u) {}
+  }
+}
+
+__device__ __forceinline__ void ncclTraf94BeforeConsumption() {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr || c->family != ncclTraf94DelayedConsumption ||
+      ncclShmem.comm.rank != (int)c->consumerRank) return;
+  int rank = ncclShmem.comm.rank;
+  if (atomicCAS_system(&c->consumptionDelayApplied[rank], 0u, 1u) == 0u) {
+    uint64_t begin = clock64();
+    while (clock64() - begin < c->delayCycles) {}
+    c->observedDelay[rank] = clock64() - begin;
+    __threadfence_system();
+    atomicExch_system(&c->consumptionDelayApplied[rank], 2u);
+  } else {
+    while (atomicAdd_system(&c->consumptionDelayApplied[rank], 0u) != 2u) {}
+  }
+}
+
+__device__ __forceinline__ void ncclTraf94FinishConsumerStep() {
+  ncclTraf94Control* c = ncclTraf94();
+  if (c == nullptr) return;
+  int rank = ncclShmem.comm.rank;
+  if (rank == (int)c->consumerRank)
+    atomicMax_system((unsigned long long*)&c->intervalEnd[rank],
+                     (unsigned long long)ncclTraf94Timestamp());
+  if (c->diagnostic) atomicAdd_system((unsigned long long*)&c->consumedSteps, 1ULL);
+}
