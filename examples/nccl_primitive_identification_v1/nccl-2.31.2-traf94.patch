+/*************************************************************************
+ * TRAF-94 experimental primitive instrumentation.
+ *
+ * This header is intentionally self-contained so the measurement harness and
+ * NCCL's host/device compilation see the identical ABI.  It is not a public
+ * NCCL API and must only be used with the source commit named by the study.
+ *************************************************************************/
+#ifndef NCCL_TRAF94_H_
+#define NCCL_TRAF94_H_
+
+#include <stdint.h>
+
+#define NCCL_TRAF94_MAGIC 0x5452414639347631ULL /* "TRAF94v1" */
+#define NCCL_TRAF94_MAX_RANKS 8
+#define NCCL_TRAF94_MAX_CHANNELS 32
