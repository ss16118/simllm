+  ncclTraf94Disabled = 0,
+  ncclTraf94AlreadyReady = 1,
+  ncclTraf94DelayedPublication = 2,
+  ncclTraf94DelayedConsumption = 3,
+  ncclTraf94Copy = 4,
+  ncclTraf94Sum = 5,
+};
+
+enum ncclTraf94Placement {
+  ncclTraf94PlacementNA = 0,
+  ncclTraf94Buffered = 1,
+  ncclTraf94BufferedRead = 2,
+  /* Evidence-only value: the node selected DirectWrite, not requested read. */
+  ncclTraf94DirectWrite = 3,
+};
+
+/*
+ * One managed-memory instance is shared by every rank in a probe process.
+ * Per-rank fields avoid cross-device timestamp arithmetic.  All counters are
+ * diagnostic evidence; the ordinary path leaves them untouched except for the
+ * compact geometry/timer fields explicitly required on every result row.
+ */
+struct alignas(16) ncclTraf94Control {
+  uint64_t magic;
+  uint32_t enabled;
+  uint32_t diagnostic;
+  uint32_t family;
+  uint32_t requestedProtocol;
+  uint32_t requestedPlacement;
+  uint32_t requestedWorkingWarps;
+  uint32_t producerRank;
+  uint32_t consumerRank;
+  uint32_t forceEmpty;
+  uint64_t delayCycles;
+  uint64_t usefulBytes;
+
+  uint32_t consumerStarted;
+  uint32_t producerReleased;
+  uint32_t unsupportedSite;
+  uint32_t reserved;
+
+  uint64_t readinessChecks;
+  uint64_t unsuccessfulChecks;
+  uint64_t successfulObservations;
+  uint64_t tailPublications;
+  uint64_t headPublications;
+  uint64_t sourceLoadBytes;
+  uint64_t sharedStagingBytes;
+  uint64_t remoteReadBytes;
+  uint64_t remoteWriteBytes;
+  uint64_t consumedSteps;
+
+  uint32_t realizedProtocol[NCCL_TRAF94_MAX_RANKS]; /* protocol enum + 1 */
+  uint32_t realizedBlockThreads[NCCL_TRAF94_MAX_RANKS];
+  uint32_t realizedWorkWarps[NCCL_TRAF94_MAX_RANKS];
+  uint32_t realizedChannelMask[NCCL_TRAF94_MAX_RANKS];
+  /* Bit N means at least one active wait role executed placement enum N. */
+  uint32_t realizedPlacementMask[NCCL_TRAF94_MAX_RANKS];
+  /* Peer rank + 1 by rank/channel; zero means that direction is absent. */
+  uint32_t realizedRecvPeer[NCCL_TRAF94_MAX_RANKS][NCCL_TRAF94_MAX_CHANNELS];
+  uint32_t realizedSendPeer[NCCL_TRAF94_MAX_RANKS][NCCL_TRAF94_MAX_CHANNELS];
+  uint64_t realizedSmMaskLo[NCCL_TRAF94_MAX_RANKS];
+  uint64_t realizedSmMaskHi[NCCL_TRAF94_MAX_RANKS];
+  uint64_t realizedSmMask2[NCCL_TRAF94_MAX_RANKS];
+  uint64_t observedInputPtr[NCCL_TRAF94_MAX_RANKS];
+  uint64_t intervalBegin[NCCL_TRAF94_MAX_RANKS];
+  uint64_t intervalEnd[NCCL_TRAF94_MAX_RANKS];
+  uint64_t observedDelay[NCCL_TRAF94_MAX_RANKS];
+  uint32_t consumptionDelayApplied[NCCL_TRAF94_MAX_RANKS];
+  uint32_t publicationDelayApplied[NCCL_TRAF94_MAX_RANKS];
+
+  uint64_t canary;
+};
